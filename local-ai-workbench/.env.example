# ============================================================
#  AI Teacher Workbench - configuration
#  Copy this file to ".env" and edit the values you need.
#  Everything in this file is YOUR choice. Nothing is sent
#  anywhere except where you point the app.
# ============================================================

# ---- Which AI engine to use? ----
#  "ollama" = free, runs on THIS computer (fully offline).  (default)
#  "cloud"  = Ollama Cloud API (free tier or paid). Needs an API key below.
PROVIDER=ollama

# ------------------------------------------------------------
#  OPTION A: Local Ollama (free, offline)
#  Install Ollama, then pull a model:
#     macOS/Linux:  ollama pull llama3.2
#     Windows:      open Command Prompt, run  ollama pull llama3.2
#  Good small models: llama3.2 (fast), qwen2.5, gemma2, llama3.1
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------
#  OPTION B: Ollama Cloud API
#  Get a free API key at  https://ollama.com/signup  (Ollama Cloud).
#  Set PROVIDER=cloud above, then paste your key here.
# ------------------------------------------------------------
CLOUD_BASE_URL=https://api.ollama.com/v1
CLOUD_MODEL=llama3.3
OLLAMA_API_KEY=

# ------------------------------------------------------------
#  Safety limits (tweak only if you hit problems)
# ------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_STUDENT_WORK_FILES=60
MAX_CONTEXT_CHARS=40000
REQUEST_TIMEOUT_S=600

# ------------------------------------------------------------
#  Optional: where uploads and PDFs are saved
# ------------------------------------------------------------
# UPLOAD_DIR=uploads
# OUTPUT_DIR=output

# Secret used for web session cookies. Change to anything random.
SECRET_KEY=change-me-workbench
